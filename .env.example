# Modèle de configuration : COPIER ce fichier en .env (ne pas le renommer),
# puis remplir les valeurs dans .env. Le fichier .env n'est pas versionné.

# Client ID de l'API officielle MyAnimeList v2
# À créer sur https://myanimelist.net/apiconfig (type d'application : "other")
MAL_CLIENT_ID=
MAL_REDIRECT_URI=http://127.0.0.1:8501/
# Facultatif pour un client confidentiel OAuth
MAL_CLIENT_SECRET=

# Jeton API Kaggle (https://www.kaggle.com/settings -> API -> Generate New Token)
# Les jetons commencent par KGAT_. Nécessaire pour scripts/kaggle_run.py.
KAGGLE_API_TOKEN=
